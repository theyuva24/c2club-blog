---
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import PrintCover from '../components/PrintCover.astro';
import PrintFooter from '../components/PrintFooter.astro';
import PrintCTA from '../components/PrintCTA.astro';
import { blogPosts } from '../data/blogPosts.js';

interface Props {
  title: string;
  description?: string;
  isArticle?: boolean;
  printCoverTitle?: string;
  printCoverSubtitle?: string;
  showPrintCover?: boolean;
  shouldNoIndex?: boolean;
  ogImage?: string;
}

const {
  title,
  description = "Building the collaboration layer students always needed. Connecting campuses, sharing insights, growing together.",
  isArticle = false,
  printCoverTitle,
  printCoverSubtitle,
  showPrintCover = false,
  shouldNoIndex = false,
  ogImage: customOgImage
} = Astro.props;

// Normalization function to match paths reliably
const normalizePath = (path: string) => {
  if (!path) return '';
  return path
    .replace(/\.html$/, '') // Remove .html
    .replace(/\/$/, '')     // Remove trailing slash
    .toLowerCase();
};

const currentPathname = Astro.url.pathname;
const cleanPath = currentPathname.replace(/\/$/, '');
const siteUrl = 'https://c2club.in';
const canonicalUrl = cleanPath === '' ? siteUrl : `${siteUrl}${cleanPath}/`;


// Check if this matches a draft post or a template page
const normalizedCurrent = normalizePath(currentPathname);
const matchedPost = blogPosts.find(post => normalizePath(post.url) === normalizedCurrent);

const finalPrintCoverTitle = printCoverTitle || (matchedPost && matchedPost.printCoverTitle);
const finalPrintCoverSubtitle = printCoverSubtitle || (matchedPost && matchedPost.printCoverSubtitle);
const finalShowPrintCover = showPrintCover || (matchedPost && matchedPost.showPrintCover) || false;

const isDraft = matchedPost ? matchedPost.published === false : false;
const isTemplate = currentPathname.includes('blog-template');
const finalNoIndex = shouldNoIndex || isDraft || isTemplate;

// OG Image logic
let ogImage = `${siteUrl}/og-c2-club-light.webp`; // Optimized light-mode social preview
if (customOgImage) {
  ogImage = customOgImage.startsWith('http') ? customOgImage : `${siteUrl}${customOgImage}`;
} else if (isArticle && matchedPost && matchedPost.image) {
  ogImage = matchedPost.image.startsWith('http') ? matchedPost.image : `${siteUrl}${matchedPost.image}`;
}

// Schemas
// 1. Organization Schema (Global)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://c2club.in/#organization",
  "name": "C2 Club",
  "url": "https://c2club.in",
  "logo": "https://c2club.in/app-icon.png",
  "sameAs": [
    "https://play.google.com/store/apps/details?id=com.c2club.uniqueapp"
  ],
  "description": "Karnataka's student collaboration platform and campus network."
};

// 2. WebSite schema (homepage only). Add SearchAction only when a real search route exists.
const isHomepage = currentPathname === '/' || currentPathname === '/index';
const websiteSchema = isHomepage ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "C2 Club",
  "url": "https://c2club.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://c2club.in/search/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
} : null;

const appSchema = isHomepage ? {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "C2 Club: Student Community",
  "operatingSystem": "Android",
  "applicationCategory": "SocialNetworkingApplication",
  "description": "A student community platform for cross-campus connections, resources, challenges, and opportunities.",
  "url": "https://c2club.in/",
  "downloadUrl": "https://play.google.com/store/apps/details?id=com.c2club.uniqueapp",
  "image": "https://c2club.in/app-icon.png",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "publisher": { "@id": "https://c2club.in/#organization" }
} : null;

// 3. BlogPosting Schema (Article pages only)
const articleSchema = isArticle && matchedPost ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": matchedPost.title,
  "description": matchedPost.excerpt || description,
  "image": ogImage,
  "datePublished": matchedPost.datePublished || "2026-05-21",
  "dateModified": matchedPost.dateModified || matchedPost.datePublished || "2026-05-21",
  "author": {
    "@type": "Person",
    "name": matchedPost.author || "C2 Club Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "C2 Club",
    "logo": {
      "@type": "ImageObject",
      "url": "https://c2club.in/app-icon.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  {finalNoIndex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow" />
  )}

  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="C2 Club" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image:alt" content="C2 Club — Karnataka's student network" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#f5f7f2" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content="C2 Club" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/site-refresh.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="search" type="application/opensearchdescription+xml" title="Search C2 Club" href="/opensearch.xml" />

  <!-- Schema JSON-LD Injection -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
  {websiteSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />}
  {appSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />}
  {articleSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />}
</head>
<body class={isArticle ? "article-page" : ""}>
  {isArticle && <div class="progress-bar" id="progressBar"></div>}

  {finalShowPrintCover && finalPrintCoverTitle && (
    <PrintCover title={finalPrintCoverTitle} subtitle={finalPrintCoverSubtitle} />
  )}

  <MobileMenu />
  
  <Header />

  <table class="print-wrapper-table">
    <thead class="print-only"><tr><td><div class="print-global-header"></div></td></tr></thead>
    <tbody><tr><td>
      <slot />
    </td></tr></tbody>
    <tfoot class="print-only"><tr><td>
      <div class="print-global-footer">
        <strong style="color: #0f172a;">C2 Club</strong> &nbsp;&mdash;&nbsp; Student Community App
      </div>
    </td></tr></tfoot>
  </table>

  {isArticle && <PrintCTA />}

  <Footer />

  {isArticle && <PrintFooter />}

  <!-- Scripts -->
  <script is:inline>
    // Mobile menu state, keyboard handling, and focus management.
    let menuReturnFocus = null;
    function toggleMenu(forceOpen) {
      const menu = document.getElementById("mobileMenu");
      const toggle = document.getElementById("menuToggle");
      if (menu && toggle) {
        const shouldOpen = typeof forceOpen === 'boolean'
          ? forceOpen
          : !menu.classList.contains('open');
        menu.classList.toggle("open", shouldOpen);
        toggle.classList.toggle("active", shouldOpen);
        toggle.setAttribute('aria-expanded', String(shouldOpen));
        toggle.setAttribute('aria-label', shouldOpen ? 'Close navigation' : 'Open navigation');
        menu.setAttribute('aria-hidden', String(!shouldOpen));
        document.body.style.overflow = shouldOpen ? 'hidden' : '';

        if (shouldOpen) {
          menuReturnFocus = document.activeElement;
          menu.querySelector('.close-menu')?.focus();
        } else if (menuReturnFocus instanceof HTMLElement) {
          menuReturnFocus.focus();
          menuReturnFocus = null;
        }
      }
    }
    window.toggleMenu = toggleMenu;

    document.addEventListener('keydown', (event) => {
      const menu = document.getElementById('mobileMenu');
      if (!menu?.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        toggleMenu(false);
        return;
      }
      if (event.key !== 'Tab') return;
      const focusable = [...menu.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')]
        .filter((item) => item instanceof HTMLElement);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Reading progress bar logic
    if (document.getElementById("progressBar")) {
      window.addEventListener("scroll", () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        document.getElementById("progressBar").style.width = scrolled + "%";
      });
    }

    // Small, progressive interactions. Content remains visible without JavaScript.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const revealTargets = document.querySelectorAll('.pain-card, .feature-card, .step-tile, .refresh-blog-card, .arena-strip, .faq-item, .challenge-card');
      revealTargets.forEach((item, index) => {
        item.classList.add('reveal-ready');
        item.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 55}ms`);
      });
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      revealTargets.forEach((item) => revealObserver.observe(item));
    }
  </script>
</body>
</html>
