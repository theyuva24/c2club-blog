---
const { pathname } = Astro.url;
const cleanPath = pathname.replace(/\/$/, "");
---
<div class="mobile-menu-backdrop" id="mobileMenu">
  <div class="mobile-menu-drawer">
    <div class="drawer-header">
      <div class="logo">
          <img src="/app-icon.png" width="24" height="24" alt="C2 Club" style="border-radius: 4px;" />
        <span class="logo-text">C2<span class="logo-text-light">Club</span></span>
      </div>
      <button class="close-menu" onclick="toggleMenu()" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <nav class="drawer-links">
      <a href="/" class={cleanPath === "" || cleanPath === "/" ? "active" : ""}>Home</a>
      <a href="/challenges/" class={cleanPath === "/challenges" ? "active" : ""}>Challenges</a>
      <a href="/blog/" class={cleanPath.startsWith("/blog") ? "active" : ""}>Blog</a>
      <a href="/contact/" class={cleanPath === "/contact" ? "active" : ""}>Contact</a>
    </nav>
    
    <div class="drawer-footer">
      <a
        href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp"
        class="drawer-btn"
      >
        Get App
      </a>
      <p class="drawer-meta">Connecting campuses, sharing insights.</p>
    </div>
  </div>
</div>

<script>
  // Add programmatic backdrop click close listener
  const backdrop = document.getElementById("mobileMenu");
  if (backdrop) {
    backdrop.addEventListener("click", (event) => {
      if (event.target === backdrop) {
        if (typeof (window as any).toggleMenu === "function") {
          (window as any).toggleMenu();
        } else {
          // Fallback manual toggle if layout script is not ready
          const menu = document.getElementById("mobileMenu");
          const toggle = document.getElementById("menuToggle");
          if (menu && toggle) {
            menu.classList.remove("open");
            toggle.classList.remove("active");
          }
        }
      }
    });
  }
</script>

<style>
  /* Slide-out mobile menu backdrop */
  .mobile-menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-menu-backdrop.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Drawer panel */
  .mobile-menu-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    height: 100%;
    background: #ffffff;
    box-shadow: -10px 0 40px rgba(15, 23, 42, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-color-scheme: dark) {
    .mobile-menu-drawer {
      background: #181818;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.5);
    }
  }

  .mobile-menu-backdrop.open .mobile-menu-drawer {
    transform: translateX(0);
  }

  /* Drawer Header */
  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-light, #f1f5f9);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-text {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary, #0f172a);
  }

  .logo-text-light {
    font-weight: 400;
    color: var(--text-secondary, #475569);
  }

  .close-menu {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary, #475569);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: 50%;
    transition: all 0.2s ease;
  }

  .close-menu:hover {
    color: var(--accent, #22c55e);
    background-color: var(--bg-subtle, #f0fdf4);
    transform: rotate(90deg);
  }

  /* Drawer navigation links */
  .drawer-links {
    display: flex;
    flex-direction: column;
    padding: 24px;
    gap: 8px;
  }

  .drawer-links a {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-secondary, #475569);
    padding: 12px 16px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-links a:hover,
  .drawer-links a.active {
    color: var(--accent, #22c55e);
    background-color: var(--bg-subtle, #f0fdf4);
    font-weight: 600;
  }

  /* Drawer footer area */
  .drawer-footer {
    margin-top: auto;
    padding: 24px;
    border-top: 1px solid var(--border-light, #f1f5f9);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drawer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent, #22c55e);
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: var(--radius, 12px);
    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.2);
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .drawer-btn:hover {
    background-color: var(--accent-hover, #16a34a);
    box-shadow: 0 6px 20px rgba(34, 197, 94, 0.3);
  }

  .drawer-meta {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    text-align: center;
    margin: 0;
  }
</style>
