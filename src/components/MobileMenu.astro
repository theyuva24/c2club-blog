---
const { pathname } = Astro.url;
const cleanPath = pathname.replace(/\/$/, "");
---
<div class="mobile-menu-backdrop" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true">
  <div class="mobile-menu-drawer" tabindex="-1">
    <div class="drawer-header">
      <a class="drawer-brand" href="/" aria-label="C2 Club home"><span>C2</span><strong>C2 Club</strong></a>
      <button class="close-menu" type="button" onclick="toggleMenu(false)" aria-label="Close navigation">×</button>
    </div>
    <nav class="drawer-links" aria-label="Mobile navigation">
      <a href="/" class={cleanPath === "" || cleanPath === "/" ? "active" : ""}><span>01</span> Home</a>
      <a href="/challenges/" class={cleanPath === "/challenges" ? "active" : ""}><span>02</span> Challenges</a>
      <a href="/blog/" class={cleanPath.startsWith("/blog") ? "active" : ""}><span>03</span> Blog</a>
      <a href="/search/" class={cleanPath === "/search" ? "active" : ""}><span>04</span> Search</a>
      <a href="/contact/" class={cleanPath === "/contact" ? "active" : ""}><span>05</span> Contact</a>
    </nav>
    <div class="drawer-footer">
      <p>One student network.<br/>More opportunities beyond campus.</p>
      <a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="drawer-btn">Get C2 Club <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</div>
<script>
  const backdrop = document.getElementById("mobileMenu");
  backdrop?.addEventListener("click", (event) => { if (event.target === backdrop) (window as any).toggleMenu?.(false); });
  backdrop?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (window as any).toggleMenu?.(false)));
</script>
<style>
  .mobile-menu-backdrop { position: fixed; inset: 0; z-index: 10000; opacity: 0; visibility: hidden; pointer-events: none; background: rgba(16,32,24,.28); backdrop-filter: blur(10px); transition: opacity .25s ease, visibility .25s ease; }
  .mobile-menu-backdrop.open { opacity: 1; visibility: visible; pointer-events: auto; }
  .mobile-menu-drawer { position: absolute; inset: 0 0 0 auto; width: min(390px, 92vw); display: flex; flex-direction: column; color: #102018; background: #f8faf5; border-left: 1px solid rgba(16,32,24,.1); transform: translateX(100%); transition: transform .3s cubic-bezier(.2,.8,.2,1); }
  .mobile-menu-backdrop.open .mobile-menu-drawer { transform: translateX(0); }
  .drawer-header { display: flex; align-items: center; justify-content: space-between; padding: 22px; border-bottom: 1px solid rgba(16,32,24,.09); }
  .drawer-brand { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
  .drawer-brand span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; color: #07120d; background: #63f28c; font-size: .78rem; font-weight: 900; }
  .drawer-brand strong { font-size: 1rem; }
  .close-menu { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgba(16,32,24,.12); border-radius: 12px; color: #102018; background: rgba(16,32,24,.04); font: 300 1.8rem/1 sans-serif; cursor: pointer; }
  .drawer-links { display: grid; gap: 5px; padding: 26px 18px; }
  .drawer-links a { display: flex; align-items: baseline; gap: 17px; padding: 15px 14px; border-radius: 13px; color: #526158; font-size: 1.25rem; font-weight: 700; text-decoration: none; }
  .drawer-links a span { color: #5f7467; font-size: .65rem; font-weight: 800; }
  .drawer-links a:hover, .drawer-links a.active { color: #102018; background: rgba(16,32,24,.06); }
  .drawer-links a.active span { color: #63f28c; }
  .drawer-footer { margin-top: auto; padding: 26px 22px 30px; border-top: 1px solid rgba(16,32,24,.09); }
  .drawer-footer p { margin: 0 0 20px; color: #8fa297; font-size: .9rem; }
  .drawer-btn { display: flex; justify-content: space-between; padding: 15px 17px; border-radius: 14px; color: #07120d; background: #63f28c; font-weight: 850; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .mobile-menu-backdrop, .mobile-menu-drawer { transition: none; } }
</style>
