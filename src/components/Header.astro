---
const { pathname } = Astro.url;
const cleanPath = pathname.replace(/\/$/, "");
---
<header class="navbar">
  <div class="container nav-container">
    <a class="brand" href="/" aria-label="C2 Club home">
      <span class="brand-mark" aria-hidden="true">C2</span>
      <span class="brand-copy"><strong>C2 Club</strong><small>Student network</small></span>
    </a>

    <ul class="nav-links" aria-label="Primary navigation">
      <li><a href="/" class={cleanPath === "" || cleanPath === "/" ? "active" : ""}>Home</a></li>
      <li><a href="/challenges/" class={cleanPath === "/challenges" ? "active" : ""}>Challenges</a></li>
      <li><a href="/blog/" class={cleanPath.startsWith("/blog") ? "active" : ""}>Blog</a></li>
      <li><a href="/search/" class={cleanPath === "/search" ? "active" : ""}>Search</a></li>
      <li><a href="/contact/" class={cleanPath === "/contact" ? "active" : ""}>Contact</a></li>
    </ul>

    <div class="nav-actions">
      <a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="nav-btn">Get the app <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobileMenu" aria-expanded="false" aria-haspopup="dialog" id="menuToggle" onclick="toggleMenu()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector('.navbar');
  const syncNavbar = () => navbar?.classList.toggle('scrolled', window.scrollY > 10);
  syncNavbar();
  window.addEventListener('scroll', syncNavbar, { passive: true });
</script>

<style>
  .navbar { position: sticky; top: 0; width: 100%; z-index: 1000; border-bottom: 1px solid rgba(16,32,24,.09); color: #102018; background: rgba(250,252,248,.9); backdrop-filter: blur(18px) saturate(140%); transition: background .2s ease, box-shadow .2s ease; }
  .navbar.scrolled { background: rgba(250,252,248,.975); box-shadow: 0 14px 40px rgba(25,50,35,.09); }
  .nav-container { height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; color: inherit; text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 13px; color: #07120d; background: #63f28c; font-size: .85rem; font-weight: 950; letter-spacing: -.04em; box-shadow: 0 8px 22px rgba(53,217,109,.18); }
  .brand-copy { display: grid; line-height: 1.05; }
  .brand-copy strong { color: #102018; font-size: .98rem; letter-spacing: -.02em; }
  .brand-copy small { margin-top: 4px; color: #718078; font-size: .65rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .nav-links { display: flex; align-items: center; gap: 4px; margin: 0; padding: 5px; list-style: none; border: 1px solid rgba(16,32,24,.08); border-radius: 15px; background: rgba(16,32,24,.035); }
  .nav-links a { display: block; padding: 8px 13px; border-radius: 10px; color: #526158; font-size: .84rem; font-weight: 700; text-decoration: none; }
  .nav-links a:hover, .nav-links a.active { color: #102018; background: rgba(16,32,24,.07); }
  .nav-links a.active::after { content: ""; display: block; width: 4px; height: 4px; margin: 4px auto -4px; border-radius: 50%; background: #63f28c; }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 10px 15px; border-radius: 12px; color: #07120d; background: #63f28c; font-size: .84rem; font-weight: 850; text-decoration: none; }
  .nav-btn:hover { color: #07120d; background: #82f7a2; transform: translateY(-1px); }
  .menu-toggle { display: none; width: 44px; height: 44px; padding: 11px; border: 1px solid rgba(16,32,24,.12); border-radius: 12px; background: rgba(16,32,24,.04); cursor: pointer; }
  .menu-toggle span { display: block; width: 100%; height: 2px; margin: 4px 0; border-radius: 2px; background: #102018; }
  @media (max-width: 800px) { .nav-links, .nav-btn { display: none; } .menu-toggle { display: block; } .nav-container { height: 68px; } }
  @media (prefers-reduced-motion: reduce) { .navbar, .nav-btn { transition: none; } }
</style>
