---
const { pathname } = Astro.url;
// Normalize path for matching (e.g. remove trailing slash, handle exact .html routing)
const cleanPath = pathname.replace(/\/$/, "");
---
<header class="navbar">
  <div class="container nav-container">
    <div class="logo">
      <a href="/">

        <span class="logo-text">C2<span class="logo-text-light">Club</span></span>
      </a>
    </div>
    
    <button
      class="menu-toggle"
      aria-label="Toggle navigation"
      id="menuToggle"
      onclick="toggleMenu()"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <ul class="nav-links">
      <li><a href="/" class={cleanPath === "" || cleanPath === "/" ? "active" : ""}>Home</a></li>
      <li><a href="/challenges.html" class={cleanPath === "/challenges.html" ? "active" : ""}>Challenges</a></li>
      <li><a href="/blog/index.html" class={cleanPath.startsWith("/blog") ? "active" : ""}>Blog</a></li>
      <li><a href="/contact.html" class={cleanPath === "/contact.html" ? "active" : ""}>Contact</a></li>
      <li>
        <a
          href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp"
          class="nav-btn"
          >Get App</a
        >
      </li>
    </ul>
  </div>
</header>

<script>
  // Add scroll class to navbar for modern glassmorphism effect
  const navbar = document.querySelector('.navbar');
  if (navbar) {
    // Initial check
    if (window.scrollY > 10) {
      navbar.classList.add('scrolled');
    }
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    });
  }
</script>

<style>
  /* Header styling */
  .navbar {
    position: sticky;
    top: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--border-light, #f1f5f9);
    z-index: 1000;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar.scrolled {
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 8px -1px rgba(15, 23, 42, 0.03);
    background: rgba(255, 255, 255, 0.9);
    border-bottom-color: rgba(226, 232, 240, 0.8);
  }

  :global(.article-page) .navbar {
    border-bottom-color: var(--border-color, #e2e8f0);
  }

  @media (prefers-color-scheme: dark) {
    .navbar {
      background: rgba(15, 15, 15, 0.8);
      border-bottom-color: var(--border-light, #1f1f1f);
    }
    .navbar.scrolled {
      background: rgba(15, 15, 15, 0.95);
      border-bottom-color: var(--border-color, #2a2a2a);
    }
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 72px; /* standard tall navbar height */
  }

  /* Logo styling */
  .logo a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo-icon {
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .logo a:hover .logo-icon {
    transform: rotate(5deg) scale(1.05);
  }

  .logo-text {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary, #0f172a);
  }

  .logo-text-light {
    font-weight: 400;
    color: var(--text-secondary, #475569);
  }

  /* Navigation Links styling */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a:not(.nav-btn) {
    display: inline-block;
    padding: 8px 16px;
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text-secondary, #475569);
    border-radius: var(--radius-full, 9999px);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .nav-links a:not(.nav-btn):hover {
    color: var(--accent, #22c55e);
    background-color: var(--bg-subtle, #f0fdf4);
  }

  .nav-links a:not(.nav-btn).active {
    color: var(--accent, #22c55e);
    background-color: var(--bg-subtle, #f0fdf4);
    font-weight: 600;
  }

  /* Get App Button */
  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent, #22c55e);
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 8px 20px;
    border-radius: var(--radius-full, 9999px);
    box-shadow: 0 4px 14px rgba(34, 197, 94, 0.2);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    margin-left: 8px;
  }

  .nav-btn:hover {
    background-color: var(--accent-hover, #16a34a);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(34, 197, 94, 0.3);
  }

  /* Hamburger Menu Toggle Button */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 16px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10001;
    padding: 0;
  }

  .menu-toggle span {
    width: 100%;
    height: 2px;
    background: var(--text-primary, #0f172a);
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }

  :global(.menu-toggle.active) span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(.menu-toggle.active) span:nth-child(2) {
    opacity: 0;
  }

  :global(.menu-toggle.active) span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Responsive styling */
  @media (max-width: 767px) {
    .nav-container {
      height: 64px;
    }
    
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>
