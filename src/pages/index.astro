---
import Layout from '../layouts/Layout.astro';
import { blogPosts } from '../data/blogPosts.js';

const pageTitle = "C2 Club | Karnataka's Student Network";
const visiblePosts = blogPosts.filter((post) => post.published !== false).slice(0, 6);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How can I connect with students from other campuses in Karnataka?", "acceptedAnswer": { "@type": "Answer", "text": "C2 Club provides campus and cross-campus hubs where students can connect, share resources, and collaborate beyond their own college." } },
    { "@type": "Question", "name": "Where can I find study resources and previous year question papers?", "acceptedAnswer": { "@type": "Answer", "text": "Students share notes, academic resources, and previous year question papers inside relevant campus and course communities on C2 Club." } },
    { "@type": "Question", "name": "Can I discover internships, challenges, and project teammates?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. C2 Club helps students discover opportunities, participate in challenges, and connect with peers who want to build and learn together." } },
    { "@type": "Question", "name": "Is C2 Club free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. C2 Club is free to use and is built for Karnataka's student community." } }
  ]
};
---
<Layout title={pageTitle} description="C2 Club connects Karnataka students across campuses for communities, resources, challenges, and opportunities." isArticle={false}>
  <main class="site-shell">
    <section class="c2-hero">
      <div class="container c2-hero-grid">
        <div class="c2-hero-copy">
          <span class="c2-eyebrow">Built beyond the campus bubble</span>
          <h1>Your college is one chapter. <em>Meet the whole network.</em></h1>
          <p>Find students who think like you, resources that actually help, and opportunities your campus group never heard about.</p>
          <div class="c2-hero-actions">
            <a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="c2-btn c2-btn--primary">Get C2 Club free <span aria-hidden="true">↗</span></a>
            <a href="/challenges/" class="c2-btn c2-btn--ghost">Explore challenges</a>
          </div>
          <div class="c2-trust-row"><span>Free to join</span><span>No ads</span><span>Made for Karnataka students</span></div>
        </div>

        <div class="signal-panel" aria-label="A preview of the C2 Club student network">
          <div class="signal-head"><span class="signal-live">Campus signal live</span><small>Across Karnataka</small></div>
          <img class="signal-image" src="/images/c2-hero-banner.jpg" width="1200" height="675" alt="Students connecting through the C2 Club platform" fetchpriority="high" />
          <div class="signal-stack">
            <div class="signal-item"><span class="signal-icon">01</span><span class="signal-copy"><strong>Campus communities</strong><small>Meet students beyond your circle</small></span><span class="signal-arrow">→</span></div>
            <div class="signal-item"><span class="signal-icon">02</span><span class="signal-copy"><strong>Useful resources</strong><small>Find what your semester needs</small></span><span class="signal-arrow">→</span></div>
            <div class="signal-item"><span class="signal-icon">03</span><span class="signal-copy"><strong>Challenges & opportunities</strong><small>Show what you can do</small></span><span class="signal-arrow">→</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section site-section--paper">
      <div class="container">
        <div class="c2-section-head">
          <div><span class="c2-eyebrow">The reality</span><h2 class="c2-heading c2-heading--small">Your ambition should not depend on your college group chat.</h2></div>
          <p class="c2-lede">The right note, teammate, event, or career answer often exists—just outside your immediate circle.</p>
        </div>
        <div class="pain-grid">
          <article class="pain-card"><span class="pain-index">01</span><h3>Resources disappear</h3><p>Notes and links get buried in noisy groups exactly when you need them.</p></article>
          <article class="pain-card"><span class="pain-index">02</span><h3>Opportunities arrive late</h3><p>Hackathons, internships, and events pass before they reach your campus.</p></article>
          <article class="pain-card"><span class="pain-index">03</span><h3>Questions stay local</h3><p>Your best answer may be with a senior or student at another college.</p></article>
          <article class="pain-card"><span class="pain-index">04</span><h3>Builders stay isolated</h3><p>Good ideas stall when finding a serious teammate feels impossible.</p></article>
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container">
        <div class="c2-section-head">
          <div><span class="c2-eyebrow">One student layer</span><h2 class="c2-heading c2-heading--small">Everything useful about college, connected.</h2></div>
          <p class="c2-lede">A focused space for community, discovery, and action—not another feed designed to waste your time.</p>
        </div>
        <div class="feature-stage">
          <article class="feature-card feature-card--visual"><span class="feature-badge">Community</span><h3>Find your people beyond your campus.</h3><p>Join relevant hubs, ask honest questions, and connect with students who share your course, interests, or goals.</p><img src="/images/c2-community.jpg" loading="lazy" decoding="async" width="1200" height="675" alt="C2 Club student community interface" /></article>
          <article class="feature-card feature-card--lime"><span class="feature-badge">Resources</span><h3>Stop searching the same scattered folders.</h3><p>Discover notes, academic material, and student-shared guidance in the communities where they belong.</p></article>
          <article class="feature-card feature-card--blue"><span class="feature-badge">Momentum</span><h3>Turn “I should do more” into something real.</h3><p>Discover challenges, collaborators, and practical career guides that help you take the next step.</p></article>
        </div>
      </div>
    </section>

    <section class="site-section site-section--paper">
      <div class="container">
        <div class="c2-section-head"><div><span class="c2-eyebrow">Start simply</span><h2 class="c2-heading c2-heading--small">From campus bubble to wider network.</h2></div><p class="c2-lede">No formal networking performance. Just students helping students move forward.</p></div>
        <div class="steps-grid">
          <article class="step-tile"><img src="/images/c2-profile.jpg" loading="lazy" decoding="async" width="1200" height="675" alt="A student profile on C2 Club" /><div class="step-tile-body"><h3>Show where you belong</h3><p>Create your student identity and find your campus and interests.</p></div></article>
          <article class="step-tile"><img src="/images/c2-discussions.jpg" loading="lazy" decoding="async" width="1200" height="675" alt="A student discussion on C2 Club" /><div class="step-tile-body"><h3>Join useful conversations</h3><p>Ask, share, learn, and discover what students elsewhere already know.</p></div></article>
          <article class="step-tile"><img src="/images/c2-feed.jpg" loading="lazy" decoding="async" width="1200" height="675" alt="Student opportunities in the C2 Club feed" /><div class="step-tile-body"><h3>Act on what you find</h3><p>Enter a challenge, meet a teammate, or use a guide to plan your next move.</p></div></article>
        </div>
      </div>
    </section>

    <section class="site-section site-section--soft">
      <div class="container">
        <div class="arena-strip"><div><span class="c2-eyebrow">C2 Club Arena</span><h2>Skills deserve a stage.</h2><p>Take part in student challenges, create something worth showing, and learn alongside ambitious peers.</p><a href="/challenges/" class="c2-btn c2-btn--primary">Enter the Arena <span aria-hidden="true">→</span></a></div><img src="/images/c2-challenges.jpg" loading="lazy" decoding="async" width="1200" height="675" alt="C2 Club student challenges" /></div>
      </div>
    </section>

    <section class="site-section site-section--paper">
      <div class="container">
        <div class="c2-section-head"><div><span class="c2-eyebrow">Student playbook</span><h2 class="c2-heading c2-heading--small">Useful reads for the decisions ahead.</h2></div><a href="/blog/" class="c2-btn c2-btn--dark">View all articles</a></div>
        <div class="refresh-blog-grid">
          {visiblePosts.map((post) => <article class="refresh-blog-card"><img src={post.image} width="1200" height="675" loading="lazy" decoding="async" alt="" /><div class="refresh-blog-body"><h3><a href={post.url}>{post.title.replace(/^What After PUC\?\s*/i, '')}</a></h3><p>{post.excerpt}</p><span class="refresh-blog-meta">{post.date} · {post.readTime}</span></div></article>)}
        </div>
      </div>
    </section>

    <section class="site-section site-section--dark">
      <div class="container faq-refresh">
        <div><span class="c2-eyebrow">Straight answers</span><h2 class="c2-heading c2-heading--small">Before you join.</h2><p class="c2-lede">The essentials, without the sales pitch.</p></div>
        <div class="faq-list">
          <details class="faq-item"><summary>Who is C2 Club for?</summary><div class="faq-answer"><p>It is built for college students in Karnataka who want better access to peers, resources, challenges, and opportunities beyond their immediate campus circle.</p></div></details>
          <details class="faq-item"><summary>Can I connect with students from other colleges?</summary><div class="faq-answer"><p>Yes. Cross-campus discovery is central to C2 Club, while relevant campus and interest communities keep conversations useful.</p></div></details>
          <details class="faq-item"><summary>What can I find inside the app?</summary><div class="faq-answer"><p>Student communities, shared resources, discussions, challenges, guides, and connections with peers who have similar goals.</p></div></details>
          <details class="faq-item"><summary>Is C2 Club free?</summary><div class="faq-answer"><p>Yes. C2 Club is free to join and use.</p></div></details>
        </div>
      </div>
    </section>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

    <section class="site-section final-banner">
      <div class="container"><h2>College is local. Your potential is not.</h2><p>Join the student network built to help Karnataka students go further together.</p><a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="c2-btn c2-btn--dark">Download C2 Club <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
</Layout>
