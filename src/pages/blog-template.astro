---
import Layout from '../layouts/Layout.astro';
import SeriesBox from '../components/SeriesBox.astro';

// Clean title of any HTML tags
const pageTitle = "REPLACE_WITH_META_TITLE";
---
<Layout
  title={pageTitle}
  description="REPLACE_WITH_META_DESCRIPTION"
  isArticle={true}
  showPrintCover={true}
  printCoverTitle="REPLACE_WITH_BLOG_TITLE"
  printCoverSubtitle="C2 Club Special Edition · Career Insights"
  shouldNoIndex={true}
>
  <main class="article-main"> <div class="article-container"> <a href="/blog/" class="back-link">&larr; Back to blog</a> <article class="blog-article"> <header class="article-header"> <h1 class="article-title">REPLACE_WITH_BLOG_TITLE</h1> <div class="article-meta"> <span>REPLACE_DATE</span> <span class="meta-dot">&middot;</span> <span class="read-time">REPLACE_READ_TIME</span> </div> <button id="download-pdf-btn" onclick="window.print()">Download PDF</button> <hr class="article-meta-divider"> </header> <img src="REPLACE_IMAGE_PATH" alt="Descriptive alt text" style="width:100%;max-width:800px;display:block;margin:20px auto;border-radius:12px;"> <div class="article-body"> <!-- Blog content goes here --> <!-- Use proper H2, H3 structure --> <!-- No multiple H1 tags --> <!-- Use semantic headings --> <h2>Introduction</h2> <p>Start your blog post with a compelling introduction that hooks the reader and explains what they will
            learn.</p> <h2>Main Section Heading</h2> <p>Your main content goes here. Break it into logical sections with H2 and H3 headings.</p> <h3>Subsection Example</h3> <p>Use H3 for subsections within your main sections.</p> <h2>Conclusion</h2> <p>Summarize key takeaways and provide a clear closing thought.</p> </div> <section class="faq-section"> <h2>Frequently Asked Questions</h2> <details class="faq-item"> <summary>Question 1?</summary> <div class="faq-answer"> <p>Answer to question 1...</p> </div> </details> <details class="faq-item"> <summary>Question 2?</summary> <div class="faq-answer"> <p>Answer to question 2...</p> </div> </details> <details class="faq-item"> <summary>Question 3?</summary> <div class="faq-answer"> <p>Answer to question 3...</p> </div> </details> </section> </article> <div class="article-footer-cta"> <hr class="article-divider"> <div class="cta-block-minimal"> <h3 class="cta-heading-subtle">Continue the conversation.</h3> <p class="cta-text-subtle">Join students across campuses building structured collaboration.</p> <a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="btn btn-primary">Download C2 Club</a> </div> </div> <script type="module">document.addEventListener("DOMContentLoaded",function(){const t=document.querySelector(".article-body"),e=document.querySelector(".read-time");if(t&&e){const n=(t.innerText||t.textContent).trim().split(/\s+/).length,o=Math.ceil(n/200);e.textContent=o+" min read"}});</script> </div> </main>
</Layout>

<style is:global>
  
</style>
