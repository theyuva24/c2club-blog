  <main data-astro-cid-ftj3tdx7> <article class="article-outer" data-astro-cid-ftj3tdx7> <nav class="breadcrumbs" aria-label="Breadcrumb"> <ol> <li><a href="/">Home</a></li> <li><a href="/blog/index.html">Blog</a></li> <li aria-current="page">Defense & Merchant Navy Guide</li> </ol> </nav> <!-- Hero Section --> <header class="hero" data-astro-cid-ftj3tdx7> <span class="hero-tag" data-astro-cid-ftj3tdx7>Student Resource Series</span> <h1 data-astro-cid-ftj3tdx7>What After PUC?<br data-astro-cid-ftj3tdx7>Defense & Merchant Navy Guide Karnataka (2026)</h1> <p class="hero-lead" data-astro-cid-ftj3tdx7>
