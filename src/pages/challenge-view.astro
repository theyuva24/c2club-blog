---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Challenge | C2 Club";
---
<Layout
  title={pageTitle}
  description="Building the collaboration layer students always needed."
  isArticle={false}
>
  <main class="content-wrapper" data-astro-cid-pp6sxfwz> <div class="main-card" data-astro-cid-pp6sxfwz> <div class="header-info" data-astro-cid-pp6sxfwz> <div class="tag-row" data-astro-cid-pp6sxfwz> <span id="badge-category" class="badge badge-accent" data-astro-cid-pp6sxfwz>Challenge</span> <span id="badge-hub" class="badge badge-glass" data-astro-cid-pp6sxfwz>C2 Club</span> </div> <h1 id="title" class="challenge-title" data-astro-cid-pp6sxfwz>Loading...</h1> <p id="tagline" class="challenge-tagline" data-astro-cid-pp6sxfwz></p> </div> <!-- Timer & Quick Stats --> <div class="stats-grid" data-astro-cid-pp6sxfwz> <div class="timer-box" data-astro-cid-pp6sxfwz> <span id="timer-label" class="timer-label" data-astro-cid-pp6sxfwz>CLOSING IN</span> <div class="timer-values" data-astro-cid-pp6sxfwz> <div class="time-unit" data-astro-cid-pp6sxfwz><span id="days" class="time-val" data-astro-cid-pp6sxfwz>00</span><span class="time-label" data-astro-cid-pp6sxfwz>d</span></div> <div class="time-unit" data-astro-cid-pp6sxfwz><span id="hours" class="time-val" data-astro-cid-pp6sxfwz>00</span><span class="time-label" data-astro-cid-pp6sxfwz>h</span></div> <div class="time-unit" data-astro-cid-pp6sxfwz><span id="mins" class="time-val" data-astro-cid-pp6sxfwz>00</span><span class="time-label" data-astro-cid-pp6sxfwz>m</span></div> </div> </div> <div id="total-pool" class="timer-box" style="text-align: right; display:none;" data-astro-cid-pp6sxfwz> <span class="timer-label" data-astro-cid-pp6sxfwz>TOTAL POOL</span> <span id="pool-val" class="time-val" style="color: var(--app-accent); font-size: 32px;" data-astro-cid-pp6sxfwz>₹0</span> </div> </div> <!-- Prizes --> <section id="prizes-section" class="prize-section" style="display: none;" data-astro-cid-pp6sxfwz> <div class="section-header" data-astro-cid-pp6sxfwz> <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--app-accent)" data-astro-cid-pp6sxfwz><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" data-astro-cid-pp6sxfwz></polygon></svg> <h3 data-astro-cid-pp6sxfwz>Prizes & Rewards</h3> </div> <div id="prizes-list" class="prizes-container" data-astro-cid-pp6sxfwz></div> </section> <!-- Dynamic Sections --> <div id="sections-container" data-astro-cid-pp6sxfwz></div> </div> </main>
</Layout>


