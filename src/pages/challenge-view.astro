---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Challenge | C2 Club";
---
<Layout
  title={pageTitle}
  description="Building the collaboration layer students always needed."
  isArticle={false}
>
  <main class="content-wrapper"> <div class="main-card"> <div class="header-info"> <div class="tag-row"> <span id="badge-category" class="badge badge-accent">Challenge</span> <span id="badge-hub" class="badge badge-glass">C2 Club</span> </div> <h1 id="title" class="challenge-title">Loading...</h1> <p id="tagline" class="challenge-tagline"></p> </div> <!-- Timer & Quick Stats --> <div class="stats-grid"> <div class="timer-box"> <span id="timer-label" class="timer-label">CLOSING IN</span> <div class="timer-values"> <div class="time-unit"><span id="days" class="time-val">00</span><span class="time-label">d</span></div> <div class="time-unit"><span id="hours" class="time-val">00</span><span class="time-label">h</span></div> <div class="time-unit"><span id="mins" class="time-val">00</span><span class="time-label">m</span></div> </div> </div> <div id="total-pool" class="timer-box" style="text-align: right; display:none;"> <span class="timer-label">TOTAL POOL</span> <span id="pool-val" class="time-val" style="color: var(--app-accent); font-size: 32px;">₹0</span> </div> </div> <!-- Prizes --> <section id="prizes-section" class="prize-section" style="display: none;"> <div class="section-header"> <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--app-accent)"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> <h3>Prizes & Rewards</h3> </div> <div id="prizes-list" class="prizes-container"></div> </section> <!-- Dynamic Sections --> <div id="sections-container"></div> </div> </main>
</Layout>


