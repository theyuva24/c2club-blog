---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Challenge | C2 Club";
---
<Layout
  title={pageTitle}
  description="View the challenge brief, timeline, rules, and rewards on C2 Club."
  isArticle={false}
  shouldNoIndex={true}
>
  <main class="challenge-page">
    <a class="back-link" href="/challenges/">← All challenges</a>

    <section id="detail-loading" class="detail-state" aria-live="polite">
      <div class="detail-spinner" aria-hidden="true"></div>
      <p>Loading challenge details…</p>
    </section>

    <section id="detail-error" class="detail-state" hidden>
      <span class="detail-icon" aria-hidden="true">!</span>
      <h1>Challenge unavailable</h1>
      <p id="detail-error-message">This challenge could not be found.</p>
      <a class="primary-action" href="/challenges/">Browse current challenges</a>
    </section>

    <article id="challenge-detail" class="main-card" hidden>
      <img id="banner" class="detail-banner" alt="" hidden />
      <div class="card-body">
        <div class="tag-row">
          <span id="badge-category" class="badge badge-accent">Challenge</span>
          <span id="badge-status" class="badge badge-glass">C2 Club</span>
        </div>
        <h1 id="title" class="challenge-title"></h1>
        <p id="tagline" class="challenge-tagline"></p>

        <div class="stats-grid">
          <div class="timer-box">
            <span id="timer-label" class="timer-label">CLOSING IN</span>
            <div class="timer-values">
              <div class="time-unit"><span id="days" class="time-val">00</span><span class="time-label">days</span></div>
              <div class="time-unit"><span id="hours" class="time-val">00</span><span class="time-label">hours</span></div>
              <div class="time-unit"><span id="mins" class="time-val">00</span><span class="time-label">mins</span></div>
            </div>
          </div>
        </div>

        <section id="overview-section" class="content-section" hidden>
          <h2>Overview</h2>
          <p id="overview"></p>
        </section>

        <section id="rules-section" class="content-section" hidden>
          <h2>Rules</h2>
          <ol id="rules-list"></ol>
        </section>

        <section id="prizes-section" class="content-section" hidden>
          <h2>Prizes & rewards</h2>
          <div id="prizes-list" class="prizes-container"></div>
        </section>

        <div class="detail-cta">
          <p>Participation and submissions happen securely inside the C2 Club app.</p>
          <a class="primary-action" href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp">Open C2 Club</a>
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  import { listChallenges, type Challenge } from '../lib/challenges';

  let timerId: number | undefined;

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const setText = (id: string, value: string) => {
    const element = byId(id);
    if (element) element.textContent = value;
  };

  const getStatus = (challenge: Challenge) => {
    const now = Date.now();
    const start = challenge.startTime ? Date.parse(challenge.startTime) : Number.NaN;
    const end = challenge.submissionEndTime ? Date.parse(challenge.submissionEndTime) : Number.NaN;
    if (Number.isFinite(start) && start > now) return 'Upcoming';
    if (Number.isFinite(end) && end < now) return 'Closed';
    return 'Active';
  };

  const updateTimer = (challenge: Challenge) => {
    const status = getStatus(challenge);
    const target = status === 'Upcoming' ? challenge.startTime : challenge.submissionEndTime;
    const targetTime = target ? Date.parse(target) : Number.NaN;
    setText('badge-status', status);
    setText('timer-label', status === 'Upcoming' ? 'STARTS IN' : status === 'Closed' ? 'CHALLENGE' : 'CLOSING IN');

    if (!Number.isFinite(targetTime) || status === 'Closed') {
      setText('days', '00'); setText('hours', '00'); setText('mins', '00');
      return;
    }

    const remaining = Math.max(0, targetTime - Date.now());
    setText('days', String(Math.floor(remaining / 86400000)).padStart(2, '0'));
    setText('hours', String(Math.floor((remaining % 86400000) / 3600000)).padStart(2, '0'));
    setText('mins', String(Math.floor((remaining % 3600000) / 60000)).padStart(2, '0'));
  };

  const showError = (message: string) => {
    byId('detail-loading')?.setAttribute('hidden', '');
    byId('challenge-detail')?.setAttribute('hidden', '');
    byId('detail-error')?.removeAttribute('hidden');
    setText('detail-error-message', message);
  };

  const renderChallenge = (challenge: Challenge) => {
    setText('title', challenge.title);
    setText('tagline', challenge.tagline || 'Open the app to participate in this C2 Club challenge.');
    setText('badge-category', challenge.category || 'Challenge');

    const banner = byId<HTMLImageElement>('banner');
    if (banner && challenge.bannerUrl) {
      banner.src = challenge.bannerUrl;
      banner.alt = `${challenge.title} banner`;
      banner.referrerPolicy = 'no-referrer';
      banner.removeAttribute('hidden');
    }

    if (challenge.overview) {
      setText('overview', challenge.overview);
      byId('overview-section')?.removeAttribute('hidden');
    }

    const rules = Array.isArray(challenge.rules)
      ? challenge.rules
      : (challenge.rules || '').split(/\r?\n/).map((rule) => rule.replace(/^\s*\d+[.)]\s*/, '').trim()).filter(Boolean);
    const rulesList = byId<HTMLOListElement>('rules-list');
    if (rules.length && rulesList) {
      rulesList.replaceChildren(...rules.map((rule) => {
        const item = document.createElement('li');
        item.textContent = rule;
        return item;
      }));
      byId('rules-section')?.removeAttribute('hidden');
    }

    const prizes = Array.isArray(challenge.prizes) ? challenge.prizes : [];
    const prizesList = byId('prizes-list');
    if (prizes.length && prizesList) {
      prizesList.replaceChildren(...prizes.map((prize) => {
        const card = document.createElement('div');
        card.className = 'prize-card';
        const placement = document.createElement('strong');
        placement.textContent = prize.placement || 'Reward';
        const reward = document.createElement('span');
        reward.textContent = prize.reward || 'Recognition from C2 Club';
        card.append(placement, reward);
        return card;
      }));
      byId('prizes-section')?.removeAttribute('hidden');
    }

    updateTimer(challenge);
    timerId = window.setInterval(() => updateTimer(challenge), 60000);
    byId('detail-loading')?.setAttribute('hidden', '');
    byId('detail-error')?.setAttribute('hidden', '');
    byId('challenge-detail')?.removeAttribute('hidden');
  };

  const loadChallenge = async () => {
    const id = new URLSearchParams(window.location.search).get('id');
    if (!id) {
      showError('No challenge was selected. Return to the challenge list and choose one.');
      return;
    }
    try {
      const challenge = (await listChallenges()).find((item) => item.id === id);
      if (!challenge) {
        showError('This challenge is no longer available or the link is incorrect.');
        return;
      }
      renderChallenge(challenge);
    } catch {
      showError('Challenge details could not be loaded. Please try again later.');
    }
  };

  window.addEventListener('pagehide', () => timerId && window.clearInterval(timerId));
  loadChallenge();
</script>

<style is:global>
  :root{--app-bg:#0a0a0a;--app-surface:#151515;--app-accent:#22c55e;--app-text:#fff;--app-text-dim:rgba(255,255,255,.68)}
  body{background:var(--app-bg);color:var(--app-text)}
  .challenge-page{max-width:920px;margin:0 auto;padding:42px 20px 90px;min-height:70vh}
  .back-link{display:inline-flex;margin-bottom:22px;color:#86efac;text-decoration:none;font-weight:700}.back-link:hover{text-decoration:underline}
  .main-card{overflow:hidden;background:var(--app-surface);border:1px solid rgba(255,255,255,.08);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.28)}
  .main-card[hidden],.detail-state[hidden],.content-section[hidden],.detail-banner[hidden]{display:none}
  .detail-banner{width:100%;max-height:440px;object-fit:cover;background:#222}
  .card-body{padding:clamp(24px,5vw,48px)}
  .tag-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}.badge{padding:6px 11px;border-radius:999px;font-size:.72rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.badge-accent{color:#4ade80;background:rgba(34,197,94,.16)}.badge-glass{color:#d1d5db;background:rgba(255,255,255,.08)}
  .challenge-title{font-size:clamp(2.1rem,7vw,4rem);line-height:1.05;color:#fff;margin:0 0 14px}.challenge-tagline{font-size:clamp(1rem,2vw,1.2rem);line-height:1.7;color:var(--app-text-dim);max-width:720px;margin:0}
  .stats-grid{margin:34px 0}.timer-box{padding:22px;border-radius:18px;background:linear-gradient(135deg,rgba(34,197,94,.12),rgba(255,255,255,.03));border:1px solid rgba(34,197,94,.2)}.timer-label{display:block;color:#86efac;font-size:.72rem;font-weight:900;letter-spacing:.1em;margin-bottom:12px}.timer-values{display:flex;gap:30px}.time-unit{display:flex;flex-direction:column}.time-val{color:#fff;font-size:clamp(1.8rem,5vw,2.7rem);font-weight:900;line-height:1}.time-label{color:var(--app-text-dim);font-size:.72rem;margin-top:6px}
  .content-section{padding:26px 0;border-top:1px solid rgba(255,255,255,.08)}.content-section h2{color:#fff;font-size:1.35rem;margin:0 0 12px}.content-section p,.content-section li{color:var(--app-text-dim);line-height:1.75}.content-section ol{padding-left:22px;margin:0}.content-section li+li{margin-top:8px}
  .prizes-container{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.prize-card{display:flex;flex-direction:column;gap:6px;padding:18px;border-radius:14px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07)}.prize-card strong{color:#86efac}.prize-card span{color:var(--app-text-dim)}
  .detail-cta{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-top:24px;padding:24px;border-radius:18px;background:rgba(34,197,94,.08)}.detail-cta p{margin:0;color:var(--app-text-dim);line-height:1.5}
  .primary-action{display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;border-radius:12px;padding:12px 20px;background:var(--app-accent);color:#07120a;text-decoration:none;font-weight:850}.primary-action:hover,.primary-action:focus-visible{background:#4ade80;outline:3px solid rgba(74,222,128,.28);outline-offset:3px}
  .detail-state{max-width:620px;margin:60px auto;text-align:center;padding:48px 24px;border:1px solid rgba(255,255,255,.08);border-radius:22px;background:rgba(255,255,255,.025)}.detail-state h1{color:#fff}.detail-state p{color:var(--app-text-dim);line-height:1.65}.detail-icon{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:rgba(34,197,94,.13);color:#4ade80;font-weight:900}.detail-spinner{width:38px;height:38px;border:4px solid rgba(255,255,255,.1);border-top-color:var(--app-accent);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 18px}@keyframes spin{to{transform:rotate(360deg)}}
  @media(max-width:640px){.challenge-page{padding-top:28px}.card-body{padding:24px}.timer-values{justify-content:space-between;gap:12px}.detail-cta{align-items:stretch;flex-direction:column}.primary-action{width:100%}}
  @media(prefers-reduced-motion:reduce){.detail-spinner{animation:none}}
</style>
