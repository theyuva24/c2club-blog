---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Active Challenges | C2 Club";
---
<Layout
  title={pageTitle}
  description="Join active student challenges on C2 Club. Compete, collaborate, and win rewards with students from across India."
  isArticle={false}
>
  <main data-astro-cid-azmxsfeb> <section class="challenges-hero" data-astro-cid-azmxsfeb> <h1 data-astro-cid-azmxsfeb>Challenges</h1> <p data-astro-cid-azmxsfeb>Compete with students across India, showcase your skills, and win exclusive rewards.</p> </section> <div id="loading-state" data-astro-cid-azmxsfeb> <div class="spinner" data-astro-cid-azmxsfeb></div> <p data-astro-cid-azmxsfeb>Fetching active challenges...</p> </div> <div class="challenges-grid" id="challenges-grid" style="display: none;" data-astro-cid-azmxsfeb> <!-- Challenge cards will be injected here --> </div> </main>
</Layout>

<style is:global>
  :root{--app-bg: #0a0a0a;--app-surface: #141414;--app-accent: #39FF14;--app-text: #ffffff;--app-text-dim: rgba(255, 255, 255, .6)}body{background-color:var(--app-bg);color:var(--app-text)}.challenges-hero[data-astro-cid-azmxsfeb]{padding:80px 20px 40px;text-align:center}.challenges-hero[data-astro-cid-azmxsfeb] h1[data-astro-cid-azmxsfeb]{color:#fff;font-size:clamp(2.5rem,5vw,4rem);margin-bottom:10px}.challenges-hero[data-astro-cid-azmxsfeb] p[data-astro-cid-azmxsfeb]{color:var(--app-text-dim);max-width:600px;margin:0 auto}.challenges-grid[data-astro-cid-azmxsfeb]{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:30px;padding:40px 20px;max-width:1200px;margin:0 auto}.challenge-card[data-astro-cid-azmxsfeb]{background:var(--app-surface);border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,.05);transition:transform .3s,border-color .3s;text-decoration:none;color:inherit;display:flex;flex-direction:column}.challenge-card[data-astro-cid-azmxsfeb]:hover{transform:translateY(-8px);border-color:var(--app-accent)}.card-banner[data-astro-cid-azmxsfeb]{width:100%;height:180px;object-fit:cover;background:#222}.card-content[data-astro-cid-azmxsfeb]{padding:20px;flex-grow:1;display:flex;flex-direction:column}.card-tag[data-astro-cid-azmxsfeb]{font-size:10px;font-weight:900;color:var(--app-accent);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}.card-title[data-astro-cid-azmxsfeb]{font-size:20px;font-weight:800;margin-bottom:10px;line-height:1.2}.card-excerpt[data-astro-cid-azmxsfeb]{font-size:14px;color:var(--app-text-dim);line-height:1.5;margin-bottom:20px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.card-footer[data-astro-cid-azmxsfeb]{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:15px;border-top:1px solid rgba(255,255,255,.05)}.status-badge[data-astro-cid-azmxsfeb]{font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;background:#ffffff1a}.status-active[data-astro-cid-azmxsfeb]{background:#39ff1433;color:var(--app-accent)}#loading-state[data-astro-cid-azmxsfeb]{text-align:center;padding:100px}.spinner[data-astro-cid-azmxsfeb]{width:40px;height:40px;border:4px solid rgba(255,255,255,.1);border-top:4px solid var(--app-accent);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 20px}@keyframes spin{0%{transform:rotate(0)}to{transform:rotate(360deg)}}
</style>
