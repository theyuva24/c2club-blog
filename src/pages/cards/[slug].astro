const initialArch = ARCHETYPES.find(a => a.slug === normalizedSlug) || ARCHETYPES[1];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{initialArch.name} | C2 Campus Card</title>
<meta name="description" content={`Someone dropped the ${initialArch.name} card for you on campus! ${initialArch.roast}`}>
<meta property="og:title" content={`${initialArch.name} | C2 Campus Card`}>
<meta property="og:description" content={initialArch.roast}>
<meta property="og:image" content={`https://c2club.in${initialArch.frontImg}`}>
<meta name="theme-color" content={initialArch.themeColor} id="themeMeta">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=Figtree:wght@600;700;800;900&display=swap" rel="stylesheet">

<style is:global>
  :root {
    --card-theme: #1D4ED8;
    --card-glow: #3B82F6;
    --ink: #04241B;
    --bg-base: #078C5E;
    --display: "Bowlby One", "Arial Black", Impact, sans-serif;
    --body: "Figtree", system-ui, -apple-system, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { min-height: 100%; min-height: 100dvh; }

  body {
    background-color: var(--bg-base);
    background-image: 
      radial-gradient(var(--card-theme, #1D4ED8) 1.5px, transparent 2px),
      radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.12), transparent 70%);
    background-size: 20px 20px, 100% 100%;
    color: #FFFFFF;
    font-family: var(--body);
    font-weight: 700;
    padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
    overflow-x: hidden;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.4s ease;
  }

  .stage-wrap {
    max-width: 440px;
    margin: 0 auto;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 14px 16px 24px;
    position: relative;
  }

  .screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
    animation: popIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28) both;
  }
  .screen.active { display: flex; }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.97) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* Top Hook Pill */
  .vibe-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #052319;
    color: #FFE680;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    box-shadow: 0 4px 0 rgba(0,0,0,0.3);
    margin-bottom: 8px;
    border: 1.5px solid rgba(255,255,255,0.25);
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF4757;
    box-shadow: 0 0 8px #FF4757;
    animation: pulseDot 1.4s infinite;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.7); }
  }

  /* Hero Headline */
  .hero-headline {
    font-family: var(--display);
    font-size: clamp(1.4rem, 6.5vw, 1.95rem);
    line-height: 1.12;
    text-shadow: 0 3px 0 var(--ink), 0 6px 14px rgba(0,0,0,0.4);
    text-align: center;
    margin-bottom: 10px;
    text-wrap: balance;
  }
  .hero-name-pill {
    color: #FFE680;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  /* 3D CARD SHOWCASE CONTAINER */
  .card-container {
    position: relative;
    width: min(72vw, 250px);
    aspect-ratio: 681 / 1020;
    margin: 6px auto 10px;
    perspective: 1200px;
    touch-action: pan-y;
  }

  /* Floating Sticker Reactions Around Card */
  .floating-badge {
    position: absolute;
    z-index: 10;
    background: #04241B;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 5px 10px;
    border-radius: 999px;
    border: 2px solid #FFFFFF;
    box-shadow: 0 4px 10px rgba(0,0,0,0.35);
    white-space: nowrap;
    pointer-events: none;
    letter-spacing: 0.3px;
  }
  .badge-tl {
    top: -6px;
    left: -12px;
    animation: floatLeft 3.6s ease-in-out infinite;
  }
  .badge-tr {
    bottom: 24px;
    right: -14px;
    background: #FFE680;
    color: #04241B;
    border-color: #04241B;
    animation: floatRight 3.2s ease-in-out infinite;
  }
  @keyframes floatLeft {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-7px) rotate(-1deg); }
  }
  @keyframes floatRight {
    0%, 100% { transform: translateY(0) rotate(4deg); }
    50% { transform: translateY(-8px) rotate(1deg); }
  }

  /* The 3D Flip Card */
  .card-3d {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    border-radius: 18px;
    animation: levitate 4s ease-in-out infinite;
  }
  .card-3d.flipped {
    transform: rotateY(180deg);
  }
  @keyframes levitate {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .card-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 18px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 4px solid #FFFFFF;
    box-shadow: 0 16px 36px rgba(0,0,0,0.4), 0 0 20px var(--card-glow, #3B82F6);
    object-fit: cover;
    background: #FFFFFF;
    transition: box-shadow 0.3s ease;
  }
  .card-face.back {
    transform: rotateY(180deg);
  }

  .holo-sheen {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 25%,
      rgba(255,255,255,0.3) 42%,
      rgba(255,255,255,0.8) 50%,
      rgba(255,255,255,0.2) 58%,
      transparent 75%
    );
    background-size: 250% 250%;
    mix-blend-mode: overlay;
    opacity: 0.75;
    z-index: 4;
    transition: background-position 0.15s ease-out;
  }

  /* Flip Pill Button */
  .flip-btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(4, 36, 27, 0.9);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1.5px solid rgba(255,255,255,0.4);
    margin-bottom: 12px;
    cursor: pointer;
    box-shadow: 0 3px 0 rgba(0,0,0,0.2);
    transition: transform 0.1s, background-color 0.15s;
  }
  .flip-btn-pill:hover, .flip-btn-pill:active {
    transform: scale(1.03);
    background: #04241B;
  }

  /* SNAPPY COMIC ROAST BUBBLE */
  .comic-roast-bubble {
    width: 100%;
    background: #FFFFFF;
    color: #04241B;
    border: 3px solid #04241B;
    border-radius: 18px;
    padding: 12px 14px 10px;
    box-shadow: 0 5px 0 #04241B;
    text-align: left;
    margin-bottom: 10px;
    position: relative;
  }
  .roast-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .roast-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .roast-quote {
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
    color: #04241B;
  }
  .move-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(4, 36, 27, 0.08);
    color: #04241B;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 6px;
    margin-top: 6px;
  }

  /* 3 STATS PILL ROW */
  .stat-chips-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: 100%;
    margin-bottom: 12px;
  }
  .stat-chip {
    background: rgba(4, 36, 27, 0.85);
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    padding: 6px 4px;
    text-align: center;
    box-shadow: 0 3px 0 rgba(0,0,0,0.2);
  }
  .stat-chip-top {
    font-size: 0.65rem;
    font-weight: 800;
    color: #FFE680;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
  }
  .stat-chip-val {
    font-family: var(--display);
    font-size: 0.9rem;
    color: #FFFFFF;
    margin-top: 2px;
  }

  /* 3 EXPRESSIVE ICON SUPERPOWERS */
  .superpowers-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: 100%;
    margin-bottom: 14px;
  }
  .superpower-card {
    background: rgba(255, 255, 255, 0.96);
    color: #04241B;
    border: 2.5px solid #04241B;
    border-radius: 14px;
    padding: 8px 6px 7px;
    text-align: center;
    box-shadow: 0 4px 0 #04241B;
  }
  .superpower-card .emoji {
    font-size: 1.35rem;
    display: block;
    margin-bottom: 2px;
  }
  .superpower-card .title {
    font-family: var(--display);
    font-size: 0.72rem;
    display: block;
    line-height: 1.1;
  }
  .superpower-card .sub {
    font-size: 0.66rem;
    font-weight: 800;
    color: rgba(4, 36, 27, 0.7);
    line-height: 1.15;
    margin-top: 2px;
    display: block;
  }

  /* BUTTONS & ACTIONS */
  .cta-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .cta-btn {
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 900;
    padding: 14px 18px;
    border-radius: 16px;
    border: 3px solid #04241B;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 5px 0 #04241B;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    touch-action: manipulation;
    transition: transform 0.08s, box-shadow 0.08s;
  }
  .cta-btn:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #04241B;
  }
  .cta-btn.pri {
    background: #FFE680;
    color: #04241B;
    animation: pulseCta 2.5s infinite;
  }
  @keyframes pulseCta {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }
  .cta-btn.sec {
    background: #FFFFFF;
    color: #04241B;
    font-size: 0.92rem;
    padding: 12px 14px;
  }
  .cta-btn.wa {
    background: #25D366;
    color: #04241B;
  }
  .ghost-link {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 6px;
    cursor: pointer;
    text-decoration: underline;
    opacity: 0.85;
  }

  /* SCREEN 2: "NOT ME" VIBE REALIGNMENT */
  .selector-scroll-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    width: 100%;
    padding: 4px 0 10px;
    margin-bottom: 10px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
  }
  .selector-scroll-bar::-webkit-scrollbar { display: none; }

  .arch-pill-tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(4, 36, 27, 0.45);
    border: 2px solid #04241B;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .arch-pill-tab.active {
    background: #FFE680;
    color: #04241B;
    box-shadow: 0 3px 0 #04241B;
    transform: translateY(-2px);
  }

  /* Modal */
  dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 440px;
    width: 100%;
    margin: auto auto 0;
    color: #04241B;
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .modal-card {
    background: #FFFFFF;
    border-radius: 24px 24px 0 0;
    padding: 22px 18px calc(20px + env(safe-area-inset-bottom, 0px));
    text-align: center;
    border-top: 4px solid #04241B;
  }
  .modal-card h2 {
    font-family: var(--display);
    font-size: 1.4rem;
    margin-bottom: 6px;
  }
  .modal-card p {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(4, 36, 27, 0.8);
    margin-bottom: 16px;
  }

  @media (min-width: 600px) {
    dialog { margin: auto; }
    .modal-card { border-radius: 24px; border: 4px solid #04241B; }
  }
</style>
</head>
<body>

<div class="stage-wrap">

  <!-- ================= SCREEN 1: THE VIBE DIAGNOSIS ================= -->
  <section class="screen active" id="screenReveal">
    <div class="vibe-tag">
      <span class="live-dot"></span>
      <span>Campus Identity Scan</span>
    </div>

    <h1 class="hero-headline">
      Diagnosed as the <span class="hero-name-pill" id="heroName">{initialArch.name}</span>
    </h1>

    <!-- 3D Card Stage with Floating Stickers -->
    <div class="card-container" id="stageReveal">
      <div class="floating-badge badge-tl" id="badgeTopLeft">{initialArch.badgeTopLeft}</div>
      <div class="floating-badge badge-tr" id="badgeTopRight">{initialArch.badgeTopRight}</div>

      <div class="card-3d" id="flipperReveal">
        <img class="card-face front" id="imgFrontReveal" src={initialArch.frontImg} alt={initialArch.name} loading="eager" />
        <img class="card-face back" id="imgBackReveal" src={initialArch.backImg} alt={`${initialArch.name} Back`} loading="lazy" />
        <div class="holo-sheen" id="sheenReveal"></div>
      </div>
    </div>

    <button class="flip-btn-pill" id="btnFlipReveal">
      <span>🔄 Tap card to flip</span>
      <span style="opacity:0.6">•</span>
      <span id="flipStatusReveal">Front</span>
    </button>

    <!-- Snappy Comic Roast Bubble (Iconography & Expression) -->
    <div class="comic-roast-bubble">
      <div class="roast-header">
        <span class="roast-icon" id="roastEmoji">{initialArch.emoji}</span>
        <div class="roast-quote" id="roastText">“{initialArch.roast}”</div>
      </div>
      <div class="move-pill">
        <span>⚡ MOVE:</span>
        <span id="moveText">{initialArch.move}</span>
      </div>
    </div>

    <!-- 3 Compact Stat Chips with Icons -->
    <div class="stat-chips-row" id="statsRow">
      {initialArch.stats.map(s => (
        <div class="stat-chip">
          <div class="stat-chip-top">
            <span>{s.icon}</span>
            <span>{s.label}</span>
          </div>
          <div class="stat-chip-val">{s.val}</div>
        </div>
      ))}
    </div>

    <!-- 3 Superpowers Visual Strip (No boring walls of text!) -->
    <div class="superpowers-strip">
      <div class="superpower-card">
        <span class="emoji">👑</span>
        <span class="title">Club Spot</span>
        <span class="sub">Meet {initialArch.name}s</span>
      </div>
      <div class="superpower-card">
        <span class="emoji">🚗</span>
        <span class="title">Daily Rides</span>
        <span class="sub">Split autos & bikes</span>
      </div>
      <div class="superpower-card">
        <span class="emoji">⚡</span>
        <span class="title">Campus Intel</span>
        <span class="sub">Fests & cheat notes</span>
      </div>
    </div>

    <!-- Punchy CTAs -->
    <div class="cta-column">
      <button class="cta-btn pri" id="btnClaimPrimary">
        <span>Claim My {initialArch.name} Spot 🚀</span>
      </button>
      <button class="cta-btn sec" id="btnNotMe">
        <span>💀 Wait, that's NOT me! Flip card</span>
      </button>
    </div>
  </section>

  <!-- ================= SCREEN 2: THE "NOT ME" VIBE SELECTOR ================= -->
  <section class="screen" id="screenPicker">
    <div class="vibe-tag">
      <span>🕵️‍♂️ Wrong Diagnosis?</span>
    </div>

    <h1 class="hero-headline" style="font-size:1.45rem;margin-bottom:6px;">
      Who handed you this?! 💀 Pick your REAL vibe:
    </h1>

    <!-- 11 Character Pill Selector -->
    <div class="selector-scroll-bar" id="pillTabs"></div>

    <!-- 3D Card Stage for Picker -->
    <div class="card-container" id="stagePicker">
      <div class="floating-badge badge-tl" id="pickerBadgeTopLeft"></div>
      <div class="floating-badge badge-tr" id="pickerBadgeTopRight"></div>

      <div class="card-3d" id="flipperPicker">
        <img class="card-face front" id="imgFrontPicker" src="" alt="Selected Card" loading="eager" />
        <img class="card-face back" id="imgBackPicker" src="" alt="Selected Card Back" loading="lazy" />
        <div class="holo-sheen" id="sheenPicker"></div>
      </div>
    </div>

    <button class="flip-btn-pill" id="btnFlipPicker">
      <span>🔄 Tap card to flip</span>
      <span style="opacity:0.6">•</span>
      <span id="flipStatusPicker">Front</span>
    </button>

    <!-- Comic Roast Bubble for Selected Card -->
    <div class="comic-roast-bubble" id="pickerRoastBubble">
      <div class="roast-header">
        <span class="roast-icon" id="pickerRoastEmoji"></span>
        <div class="roast-quote" id="pickerRoastText"></div>
      </div>
      <div class="move-pill">
        <span>⚡ MOVE:</span>
        <span id="pickerMoveText"></span>
      </div>
    </div>

    <!-- 3 Stat Chips for Selected Card -->
    <div class="stat-chips-row" id="pickerStatsRow"></div>

    <!-- CTAs on Screen 2 -->
    <div class="cta-column">
      <button class="cta-btn pri" id="btnClaimPicker">
        <span>Claim My Spot as <span id="pickerClaimBtnName"></span> 🚀</span>
      </button>
      <a class="cta-btn wa" id="btnCalloutWhatsApp" target="_blank" rel="noopener">
        <span>Call Out Friend on WhatsApp 💬</span>
      </a>
      <button class="ghost-link" id="btnBackToReveal">
        ← Back to original diagnosis
      </button>
    </div>
  </section>

</div>

<!-- Modal Sheet for Desktop / Non-Android -->
<dialog id="downloadModal">
  <div class="modal-card">
    <h2 id="modalTitle">Ready to enter your campus club?</h2>
    <p>Get C2 Club for daily ride matching, exclusive character clubs, and unfiltered campus intel.</p>
    <div class="cta-column">
      <a class="cta-btn pri" id="modalPlayBtn" target="_blank" rel="noopener">
        <span>Download on Google Play 📲</span>
      </a>
      <a class="cta-btn wa" id="modalWhatsAppBtn" target="_blank" rel="noopener">
        <span>Send to My Phone via WhatsApp 💬</span>
      </a>
      <button class="ghost-link" id="modalCloseBtn" style="color:#04241B;">
        Close
      </button>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ initialSlug: normalizedSlug, ARCHETYPES }}>
const APP_ID = "com.c2club.uniqueapp";
const BY_SLUG = Object.fromEntries(ARCHETYPES.map(a => [a.slug, a]));

let currentSlug = initialSlug;
let selectedPickerSlug = initialSlug;
let isRevealFlipped = false;
let isPickerFlipped = false;

// Audio synthesis
let audioCtx = null;
function playPop(freq1 = 400, freq2 = 620) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const now = audioCtx.currentTime;
    osc.frequency.setValueAtTime(freq1, now);
    osc.frequency.exponentialRampToValueAtTime(freq2, now + 0.1);
    gain.gain.setValueAtTime(0.09, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.11);
  } catch (e) {}
}

function applyTheme(a) {
  document.documentElement.style.setProperty('--card-theme', a.themeColor);
  document.documentElement.style.setProperty('--card-glow', a.glow);
  const themeMeta = document.getElementById("themeMeta");
  if (themeMeta) themeMeta.setAttribute("content", a.themeColor);
}

function setup3DTilt(containerEl, flipperEl, sheenEl) {
  if (!containerEl || !flipperEl || !sheenEl) return;

  function onMove(clientX, clientY) {
    const rect = containerEl.getBoundingClientRect();
    const x = clientX - rect.left;
    const y = clientY - rect.top;
    const rotX = ((y - rect.height / 2) / (rect.height / 2)) * -14;
    const rotY = ((x - rect.width / 2) / (rect.width / 2)) * 14;
    const isFlipped = flipperEl.classList.contains("flipped");
    const baseRotY = isFlipped ? 180 : 0;

    flipperEl.style.transform = `rotateY(${baseRotY + rotY}deg) rotateX(${rotX}deg)`;
    sheenEl.style.backgroundPosition = `${(x / rect.width) * 100}% ${(y / rect.height) * 100}%`;
  }

  function onReset() {
    const isFlipped = flipperEl.classList.contains("flipped");
    flipperEl.style.transform = isFlipped ? `rotateY(180deg)` : `rotateY(0deg)`;
    sheenEl.style.backgroundPosition = `50% 50%`;
  }

  containerEl.addEventListener("mousemove", e => onMove(e.clientX, e.clientY));
  containerEl.addEventListener("mouseleave", onReset);

  containerEl.addEventListener("touchmove", e => {
    if (e.touches && e.touches[0]) onMove(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  containerEl.addEventListener("touchend", onReset);
}

function toggleFlipReveal() {
  isRevealFlipped = !isRevealFlipped;
  document.getElementById("flipperReveal").classList.toggle("flipped", isRevealFlipped);
  document.getElementById("flipStatusReveal").textContent = isRevealFlipped ? "Back" : "Front";
  playPop(isRevealFlipped ? 360 : 560, isRevealFlipped ? 560 : 360);
}

function toggleFlipPicker() {
  isPickerFlipped = !isPickerFlipped;
  document.getElementById("flipperPicker").classList.toggle("flipped", isPickerFlipped);
  document.getElementById("flipStatusPicker").textContent = isPickerFlipped ? "Back" : "Front";
  playPop(isPickerFlipped ? 360 : 560, isPickerFlipped ? 560 : 360);
}

function renderReveal(a) {
  applyTheme(a);
  document.getElementById("heroName").textContent = a.name;
  document.getElementById("badgeTopLeft").textContent = a.badgeTopLeft;
  document.getElementById("badgeTopRight").textContent = a.badgeTopRight;
  document.getElementById("imgFrontReveal").src = a.frontImg;
  document.getElementById("imgBackReveal").src = a.backImg;
  document.getElementById("roastEmoji").textContent = a.emoji;
  document.getElementById("roastText").textContent = `“${a.roast}”`;
  document.getElementById("moveText").textContent = a.move;
  document.getElementById("btnClaimPrimary").innerHTML = `<span>Claim My ${a.name} Spot 🚀</span>`;

  document.getElementById("statsRow").innerHTML = a.stats.map(s => `
    <div class="stat-chip">
      <div class="stat-chip-top">
        <span>${s.icon}</span>
        <span>${s.label}</span>
      </div>
      <div class="stat-chip-val">${s.val}</div>
    </div>
  `).join("");
}

function renderPickerTabs() {
  const container = document.getElementById("pillTabs");
  container.innerHTML = ARCHETYPES.map(a => `
    <button class="arch-pill-tab ${a.slug === selectedPickerSlug ? 'active' : ''}" data-slug="${a.slug}">
      <span>${a.emoji}</span>
      <span>${a.name}</span>
    </button>
  `).join("");

  container.onclick = (e) => {
    const btn = e.target.closest(".arch-pill-tab");
    if (!btn) return;
    selectPickerCard(btn.dataset.slug);
  };
}

function selectPickerCard(slug) {
  selectedPickerSlug = slug;
  const a = BY_SLUG[slug] || ARCHETYPES[0];
  playPop(420, 680);
  applyTheme(a);

  document.querySelectorAll(".arch-pill-tab").forEach(tab => {
    const isActive = tab.dataset.slug === slug;
    tab.classList.toggle("active", isActive);
    if (isActive) tab.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
  });

  document.getElementById("pickerBadgeTopLeft").textContent = a.badgeTopLeft;
  document.getElementById("pickerBadgeTopRight").textContent = a.badgeTopRight;
  document.getElementById("imgFrontPicker").src = a.frontImg;
  document.getElementById("imgBackPicker").src = a.backImg;
  document.getElementById("pickerRoastEmoji").textContent = a.emoji;
  document.getElementById("pickerRoastText").textContent = `“${a.roast}”`;
  document.getElementById("pickerMoveText").textContent = a.move;
  document.getElementById("pickerClaimBtnName").textContent = a.name;

  document.getElementById("pickerStatsRow").innerHTML = a.stats.map(s => `
    <div class="stat-chip">
      <div class="stat-chip-top">
        <span>${s.icon}</span>
        <span>${s.label}</span>
      </div>
      <div class="stat-chip-val">${s.val}</div>
    </div>
  `).join("");

  const original = BY_SLUG[currentSlug] || ARCHETYPES[1];
  const shareText = `Bro, you handed me the ${original.name} card, but I'm literally the ${a.name} ${a.emoji} Check your radar on C2 Club: https://c2club.in/cards/${a.slug}?c=${currentSlug}`;
  document.getElementById("btnCalloutWhatsApp").href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
}

function handleClaim(slug) {
  const isAndroid = /android/i.test(navigator.userAgent);
  const params = new URLSearchParams(location.search);
  const college = params.get("c") || "";
  const referrer = `card_${slug}&s=qr${college ? `&c=${encodeURIComponent(college)}` : ""}`;
  const playUrl = `https://play.google.com/store/apps/details?id=${APP_ID}&referrer=${encodeURIComponent(referrer)}`;
  const marketUri = `market://details?id=${APP_ID}&referrer=${encodeURIComponent(referrer)}`;

  try { localStorage.setItem("c2_card_claim", slug); } catch (e) {}

  if (isAndroid) {
    window.location.href = marketUri;
    setTimeout(() => { window.location.href = playUrl; }, 1200);
  } else {
    const a = BY_SLUG[slug] || ARCHETYPES[0];
    document.getElementById("modalTitle").textContent = `Enter the ${a.name} Club`;
    document.getElementById("modalPlayBtn").href = playUrl;
    const waText = encodeURIComponent(`Check out the ${a.name} Card on C2 Club! Claim your spot: https://c2club.in/cards/${slug}`);
    document.getElementById("modalWhatsAppBtn").href = `https://wa.me/?text=${waText}`;
    const modal = document.getElementById("downloadModal");
    if (!modal.open) modal.showModal();
  }
}

function showScreen(id) {
  document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  window.scrollTo({ top: 0, behavior: "smooth" });
}

document.addEventListener("DOMContentLoaded", () => {
  const qSlug = new URLSearchParams(location.search).get("card");
  if (qSlug && BY_SLUG[qSlug.toLowerCase()]) currentSlug = qSlug.toLowerCase();

  const initial = BY_SLUG[currentSlug] || ARCHETYPES[1];
  renderReveal(initial);

  setup3DTilt(document.getElementById("stageReveal"), document.getElementById("flipperReveal"), document.getElementById("sheenReveal"));
  setup3DTilt(document.getElementById("stagePicker"), document.getElementById("flipperPicker"), document.getElementById("sheenPicker"));

  document.getElementById("stageReveal").addEventListener("click", toggleFlipReveal);
  document.getElementById("btnFlipReveal").addEventListener("click", toggleFlipReveal);

  document.getElementById("stagePicker").addEventListener("click", toggleFlipPicker);
  document.getElementById("btnFlipPicker").addEventListener("click", toggleFlipPicker);

  document.getElementById("btnClaimPrimary").addEventListener("click", () => handleClaim(currentSlug));
  document.getElementById("btnNotMe").addEventListener("click", () => {
    renderPickerTabs();
    const altSlug = ARCHETYPES.find(a => a.slug !== currentSlug)?.slug || ARCHETYPES[0].slug;
    selectPickerCard(altSlug);
    showScreen("screenPicker");
  });

  document.getElementById("btnBackToReveal").addEventListener("click", () => {
    applyTheme(BY_SLUG[currentSlug] || ARCHETYPES[1]);
    showScreen("screenReveal");
  });
  document.getElementById("btnClaimPicker").addEventListener("click", () => handleClaim(selectedPickerSlug));

  document.getElementById("modalCloseBtn").addEventListener("click", () => document.getElementById("downloadModal").close());
  document.getElementById("downloadModal").addEventListener("click", e => {
    if (e.target === document.getElementById("downloadModal")) document.getElementById("downloadModal").close();
  });
});
</script>
</body>
</html>
