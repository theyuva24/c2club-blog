---
export function getStaticPaths() {
  const slugs = [
    'social-butterfly',
    'topper',
    'canteen-commander',
    'professors-favorite',
    'last-bench-strategist',
    'campus-politician',
    'attendance-calculator',
    'silent-genius',
    'assignment-survivor',
    'campus-influencer',
    'all-rounder',
    '3am-debugger'
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

