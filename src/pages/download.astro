---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Download C2 Club App";
---
<Layout
  title={pageTitle}
  description="Download C2 Club - the structured student collaboration platform built for Indian campuses."
  isArticle={false}
>
  <main class="download-page"> <section class="download-hero text-center"> <div class="container"> <span class="section-label">Download</span> <h1 class="download-heading">Get C2 Club</h1> <p class="download-subtext">Join students across campuses building structured collaboration. Available free on Google Play.</p> </div> </section> <section class="download-content"> <div class="container"> <!-- Feature highlights --> <div class="how-it-works-grid" style="margin-bottom: 48px;"> <div class="step-card"> <span class="step-icon">🏛️</span> <h3>Campus Hubs</h3> <p>Connect with students from your college and beyond. Share notes, resources, and opportunities.</p> </div> <div class="step-card"> <span class="step-icon">🏆</span> <h3>Challenges & Arena</h3> <p>Compete in creative challenges, showcase your skills, and win real rewards.</p> </div> <div class="step-card"> <span class="step-icon">💬</span> <h3>Real Discussions</h3> <p>Ask questions, get honest answers, and have structured conversations with verified students.</p> </div> </div> <div class="platform-card"> <span class="platform-label">📱 Android</span> <p class="platform-desc">Available on Google Play for Indian college students.</p> <a href="https://play.google.com/store/apps/details?id=com.c2club.uniqueapp" class="btn btn-primary btn-large" style="width: 100%; max-width: 320px;"> <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
Download on Google Play
</a> <div class="download-trust-signals">
✓ Free to use &nbsp;&nbsp; ✓ Built for Indian college students &nbsp;&nbsp; ✓ No spam
</div> <p class="ios-coming-soon">iOS version coming soon.</p> </div> <div class="qr-placeholder"> <h2 class="qr-heading">Scan to download</h2> <div class="qr-box">QR Code Here</div> </div> <div class="download-fallback"> <p>Having trouble downloading? Contact us at <a href="mailto:hello@c2club.in?subject=C2%20Club%20Download%20Inquiry">hello@c2club.in</a> </p> </div> </div> </section> </main>
</Layout>


