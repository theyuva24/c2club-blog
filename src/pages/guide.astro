            <h4 style="color: #0f172a; font-weight: 700; margin-bottom: 8px;">Law Pathways</h4>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0;">↓ Download PDF</p>
          </a>
          
          <a href="/downloads/what-after-pu/aviation-aerospace-what-after-pu.pdf" target="_blank" class="stream-download-card" style="display: block; padding: 24px; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; transition: all 0.2s; background: #fff;">
