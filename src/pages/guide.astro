---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="C2 Club | Career Guide Downloads"
  description="Download the complete What After PUC Career Guide and explore various streams like Engineering, Commerce, Law, and more."
  isArticle={false}
>
  <main class="download-page">
    <section class="download-hero text-center" style="padding: 60px 20px;">
      <div class="container">
        <span class="section-label">Resources</span>
        <h1 class="download-heading" style="margin-bottom: 20px;">What After PUC? Career Guides</h1>
        <p class="download-subtext" style="max-width: 600px; margin: 0 auto; color: #64748b; font-size: 1.1rem; line-height: 1.6;">Download our comprehensive, brutally honest career guides for Karnataka students. Get the full master guide or pick your specific stream.</p>
      </div>
    </section>

    <section class="download-content" style="padding: 40px 20px 80px;">
      <div class="container" style="max-width: 800px; margin: 0 auto;">
        
        <!-- Master Guide (Featured) -->
        <div class="platform-card" style="background: #f8fafc; border: 2px solid #22c55e; border-radius: 12px; padding: 40px; margin-bottom: 40px; text-align: center;">
          <span class="platform-label" style="background: #dcfce7; color: #166534; padding: 6px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: inline-block; margin-bottom: 16px;">🌟 Highly Recommended</span>
          <h2 style="font-size: 1.8rem; font-weight: 800; color: #0f172a; margin-bottom: 12px;">The Complete Career Guide 2026</h2>
          <p style="color: #475569; margin-bottom: 30px; font-size: 1.05rem;">All 15 pathways (Engineering, Medical, Commerce, Defense, Aviation, and more) packed into one master PDF.</p>
          
          <a href="/downloads/what-after-pu/what-after-pu-complete-guide.pdf" target="_blank" class="btn btn-primary btn-large" style="background: #22c55e; color: #fff; padding: 14px 32px; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-block; box-shadow: 0 4px 14px rgba(34, 197, 94, 0.4); transition: transform 0.2s, box-shadow 0.2s;">
            ↓ Download Master Guide PDF
          </a>
        </div>

        <h3 style="font-size: 1.4rem; font-weight: 700; color: #0f172a; margin-bottom: 24px; text-align: center;">Or Download Individual Streams</h3>
        
        <div class="how-it-works-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
          
          <!-- Stream Cards -->
          <a href="/downloads/what-after-pu/engineering-pathways-what-after-pu.pdf" target="_blank" class="stream-download-card" style="display: block; padding: 24px; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; transition: all 0.2s; background: #fff;">
            <h4 style="color: #0f172a; font-weight: 700; margin-bottom: 8px;">Engineering Pathways</h4>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0;">↓ Download PDF</p>
          </a>

          <a href="/downloads/what-after-pu/medical-pathways-what-after-pu.pdf" target="_blank" class="stream-download-card" style="display: block; padding: 24px; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; transition: all 0.2s; background: #fff;">
            <h4 style="color: #0f172a; font-weight: 700; margin-bottom: 8px;">Medical Pathways</h4>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0;">↓ Download PDF</p>
          </a>

          <a href="/downloads/what-after-pu/commerce-pathways-what-after-pu.pdf" target="_blank" class="stream-download-card" style="display: block; padding: 24px; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; transition: all 0.2s; background: #fff;">
            <h4 style="color: #0f172a; font-weight: 700; margin-bottom: 8px;">Commerce Pathways</h4>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0;">↓ Download PDF</p>
          </a>

